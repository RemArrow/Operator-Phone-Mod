<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<AssemblyName>OperatorPhone</AssemblyName>
		<RootNamespace>OperatorPhone</RootNamespace>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Every .cs under the project directory is globbed automatically, including
         lib\PhotonChatApi\. Do NOT add an explicit <Compile Include> for those —
         it produces duplicate-item errors and aborts the build before anything else
         is evaluated. -->
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>

		<!-- MelonLoader's net6 assemblies are AMD64. PlatformTarget is what actually
         silences MSB3270 and fixes runtime loading. AnyCPU stays in Platforms so an
         AnyCPU solution config still maps to this project — drop it and VS reports
         "Skipped Clean" and quietly refuses to build. -->
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>

		<!-- SDK-style projects synthesise AssemblyTitle/Product/Version into obj/, which
         collides with the manual attributes in Properties/AssemblyInfo.cs. That file
         has to stay manual because MelonInfo has no MSBuild equivalent. -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<!-- Il2Cpp interop and the vendored Photon sources generate a lot of noise. -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS0649;CS0169;CS0162;CS0414;CS0618</NoWarn>

		<!-- Point this at your OPERATOR install. Override locally with:
         dotnet build -p:GameDir="D:\SteamLibrary\steamapps\common\OPERATOR" -->
		<GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\OPERATOR</GameDir>
		<MLDir>$(GameDir)\MelonLoader</MLDir>
		<InteropDir>$(MLDir)\Il2CppAssemblies</InteropDir>
	</PropertyGroup>

	<ItemGroup>
		<!-- MelonLoader core -->
		<Reference Include="MelonLoader">
			<HintPath>$(MLDir)\net6\MelonLoader.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
			<HintPath>$(MLDir)\net6\Il2CppInterop.Runtime.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2CppInterop.Common">
			<HintPath>$(MLDir)\net6\Il2CppInterop.Common.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(MLDir)\net6\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<!-- Unity interop, generated by MelonLoader on first run -->
		<Reference Include="Il2Cppmscorlib">
			<HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(InteropDir)\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(InteropDir)\UnityEngine.TextRenderingModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(InteropDir)\UnityEngine.UI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(InteropDir)\UnityEngine.UIModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UnityWebRequestModule">
			<HintPath>$(InteropDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(InteropDir)\UnityEngine.IMGUIModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<!-- Steamworks.NET as shipped by the game. Note the Il2Cpp filename prefix —
         MelonLoader renames generated assemblies, and a HintPath without it fails
         silently: MSBuild drops the reference and every type reads as missing. -->
		<Reference Include="Il2Cppcom.rlabrecque.steamworks.net">
			<HintPath>$(InteropDir)\Il2Cppcom.rlabrecque.steamworks.net.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<!-- Photon transport (SDK v5, netstandard2.0 build). Must ALSO be copied into
         the game's UserLibs\ so MelonLoader loads it at runtime — the reference alone
         only satisfies the compiler. -->
		<Reference Include="PhotonClient">
			<HintPath>lib\PhotonClient.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Drop the built DLL straight into Mods/ -->
	<Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\Mods')">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" ContinueOnError="true" />
		<Message Importance="high" Text="Deployed OperatorPhone.dll -&gt; $(GameDir)\Mods" />
	</Target>

</Project>